# Copy this file to .env and supply your own credentials. Never commit .env.
# These placeholders do not provide access to any service.

# Required: CockroachDB connection string (use your cluster's connection details).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:26257/structify?sslmode=verify-full"

# Required: Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Local application URL for Auth.js; use your deployment URL in production.
AUTH_URL="http://localhost:3000"

# OAuth credentials for each social login you intend to use.
# Register callback URLs: /api/auth/callback/google, /facebook, and /github.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email verification, password resets, and reminders.
# Email senders and production email links currently use app.structifyapp.com
# in source code; update them for your own verified domain before deployment.
RESEND_API_KEY=""
CUSTOM_TIMEZONE="UTC"

# AWS S3 file uploads. Use credentials restricted to your intended bucket.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""

# Stripe: server-only secrets. Use test credentials for local development.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_URL_SUCCESS_PRODUCTION_REDIRECT="http://localhost:3000"
STRIPE_URL_CANCEL_PRODUCTION_REDIRECT="http://localhost:3000"

# Stripe public configuration. Spelling matches the existing application code.
NEXT_PUBLIC_STANDARD_PRICE_ID=""
NEXT_PUBLIC_ENTERPRIES_PRICE_ID=""
NEXT_PUBLIC_STANDARD_PAYEMNT_LINK=""
NEXT_PUBLIC_ENTERPRIES_PAYMENT_LINK=""
NEXT_PUBLIC_BILLING_PORTAL_LINK=""

# Google Analytics measurement ID (public).
NEXT_PUBLIC_GOOGLE_ANALYTICS=""
