// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionType {
  TRIAL
  STANDARD
  ENTERPRISE
}

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  password          String?
  emailVerified     DateTime?
  isOAuth           Boolean      @default(false)
  image             String?
  accounts          Account[]
  subscriptionType                  SubscriptionType @default(TRIAL)
  role              UserRole     @default(USER)
  subscriptions Subscription[]
  client            Client[]
  invoice           Invoice[]
  employee          Employee[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String
  customerId  String @unique
  status         String
  priceId        String
  isTrialActive         Boolean  @default(true)
  trialEndDate          DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// Resuble Model
model Documents {
  id   String  @id @default(cuid())
  uuid String  @unique @default(uuid())
  name String
  type String?
  file String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id      String  @id @default(cuid())
  uuid    String  @unique @default(uuid())
  street  String
  city    String?
  state   String?
  zip     String
  country String?

  clients   Client[]
  projects  Project[]
  employees Employee[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id           String        @id @default(cuid())
  uuid         String        @unique @default(uuid())
  name         String
  organization String?
  clientId     String?
  status       ClientStatus?
  color        String?
  phone        String
  email        String?
  date         DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  address   Address? @relation(fields: [addressId], references: [id], onDelete: Cascade)
  addressId String?

  reminder Remainder[]
  project  Project[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum RemainderStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

model Remainder {
  id              String          @id @default(cuid())
  uuid            String          @unique @default(uuid())
  name            String
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  startDate       DateTime
  frequency       String
  daysOfWeek      String[]
  daysOfMonth     String[]
  reminderTime    String
  // reminderType    String?   
  emailRecipient  String
  reminderMessage String?
  status          RemainderStatus
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Project {
  id            String    @id @default(cuid())
  uuid          String    @unique @default(uuid())
  name          String
  projectId     String?
  description   String?
  projectType   String?
  projectStatus String?
  color         String?
  startDate     DateTime?
  hourlyRate    String?
  totalBudget   Float?

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  address   Address?        @relation(fields: [addressId], references: [id], onDelete: Cascade)
  addressId String?
  budget    ProjectBudget[]
  materials Material[]
  documents Documents[]
  AssignEmployee AssignEmployee[]
  projectHours ProjectHours[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
}

model ProjectHours {
  id          String    @id @default(cuid())
  uuid        String    @unique @default(uuid())
  name        String?
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade) 
  hours       Int?
  minutes     Int?
  description String?
  date        DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProjectBudget {
  id             String          @id @default(cuid())
  uuid           String          @unique @default(uuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  name           String
  totalBudget    Float
  costsIncurred  Float
  estimatedCosts EstimatedCost[]
  costOverruns   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstimatedCost {
  id              String        @id @default(cuid())
  uuid            String        @unique @default(uuid())
  projectBudgetId String
  projectBudget   ProjectBudget @relation(fields: [projectBudgetId], references: [id], onDelete: Cascade)

  type   String
  amount Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id          String    @id @default(cuid())
  uuid        String    @unique @default(uuid())
  name        String
  description String?
  status      String?
  supplier    String?
  date        DateTime?

  materialInfo MaterialInfo[]
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model MaterialInfo {
  id    String @id @default(cuid())
  uuid  String @unique @default(uuid())
  name  String
  price Int?

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id         String   @id @default(cuid())
  uuid       String   @unique @default(uuid())
  name       String
  email      String?
  color      String?
  phone      String
  address    Address? @relation(fields: [addressId], references: [id], onDelete: Cascade)
  addressId  String?
  hourlyRate Int?
  salary     Int?
  overtime Int?
  jobTitle   String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeHours EmployeeHours[] 

  startedMonth DateTime?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  AssignEmployee AssignEmployee[]
}

model EmployeeHours {
  id          String    @id @default(cuid())
  uuid        String    @unique @default(uuid())
  name        String?
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hours       Int?
  minutes     Int?
  overtime Int?
  description String?
  date        DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AssignEmployee {
  id         String    @id @default(cuid())
  uuid       String    @unique @default(uuid())
  name       String?
  
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Invoice {
  id         String    @id @default(cuid())
  uuid       String    @unique @default(uuid())
  // Company information
  name String
  invoiceNumber String?
  companyName String?
  address String?
  city String?
  postCode String?
  companyPhone String
  email String?
  companyLogo String?
  date DateTime?
  // Bill to
  clientName  String
  clientCompanyName String?
  clientAddress String?
  clientPhone String?
  clientEmail String?
  // Descriptio
  descriptions    InvoiceDescription[] @relation("InvoiceDescriptions")

  // Payemen
  subtotal Int?
  taxRate Int?
  totalTax Int?
  fullPrice Int?

  richText Json?

  userId String
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

   createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceDescription {
  id           String  @id @default(cuid())
  description  String?
  quantity     Int?
  unitPrice    Int?
  tax          Int?
  totalPrice   Int?

  invoiceId    String?
  invoice      Invoice? @relation("InvoiceDescriptions", fields: [invoiceId], references: [id], onDelete: Cascade) 

   createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

